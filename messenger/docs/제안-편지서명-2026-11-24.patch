+// 편지 서명(제안) 시험: 유도 · 확인 · 옮겨 붙이기 거절 · 옛 판과 주고받기 · 빠짐/바뀜 판정.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { generateEntropy, deriveKeyPair } from '../../hub/client/keys.mjs';
+import { seal, open } from '../../hub/client/crypto.mjs';
+import { signEnvelope, checkEnvelope, judge, deriveSigningKey } from '../../hub/client/signing.mjs';
+import { Messages } from '../messages.mjs';
+import { FakeSupa } from './_fakesupa.mjs';
+
+const party = () => ({ id: crypto.randomUUID(), ...deriveKeyPair(generateEntropy()) });
+const sign = (a, b, id, envelope) => signEnvelope({ senderPrivateRaw: a.privateRaw, senderPublicRaw: a.publicRaw, recipientPublicRaw: b.publicRaw, messageId: id, envelope });
+const check = (a, b, id, envelope) => checkEnvelope({ senderPublicRaw: a.publicRaw, recipientPublicRaw: b.publicRaw, messageId: id, envelope }).state;
+const E = { v: 1, kind: 'text', text: '안녕하세요' };
+
+test('같은 12단어면 같은 서명 열쇠, 봉투 열쇠와는 다른 열쇠', () => { const a = party(); assert.deepEqual(deriveSigningKey(a.privateRaw), deriveSigningKey(a.privateRaw)); assert.notDeepEqual(deriveSigningKey(a.privateRaw).publicRaw, a.publicRaw); });
+test('맞는 서명 · 내용/번호/받는 이/보낸 이가 다르면 거절', () => {
+  const a = party(), b = party(), c = party(), s = sign(a, b, 'm1', E);
+  assert.equal(check(a, b, 'm1', s), 'ok'); assert.equal(check(a, b, 'm1', JSON.parse(JSON.stringify(s))), 'ok');
+  assert.equal(check(a, b, 'm1', { ...s, text: '바꿈' }), 'bad'); assert.equal(check(a, b, 'm2', s), 'bad'); assert.equal(check(a, c, 'm1', s), 'bad'); assert.equal(check(c, b, 'm1', s), 'bad');
+  assert.equal(check(a, b, 'm1', { ...s, extra: 1 }), 'bad'); assert.equal(check(a, b, 'm1', E), 'none');
+  for (const sig of [null, {}, { k: 'x', s: 'y' }, 'z', { k: s.sig.k, s: 'AAAA' }]) assert.equal(check(a, b, 'm1', { ...E, sig }), 'bad');
+});
+test('판정: 처음 · 같음 · 바뀜 · 빠짐 · 옛 판', () => { assert.equal(judge({ state: 'ok', key: 'A' }, null), 'ok'); assert.equal(judge({ state: 'ok', key: 'A' }, 'A'), 'ok'); assert.equal(judge({ state: 'ok', key: 'B' }, 'A'), 'changed'); assert.equal(judge({ state: 'none' }, 'A'), 'missing'); assert.equal(judge({ state: 'none' }, null), 'none'); assert.equal(judge({ state: 'bad' }, null), 'bad'); });
+
+function world(t) {
+  const fake = new FakeSupa(), a = party(), b = party();
+  const make = async (self, other) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'iris-sig-')); t.after(() => fs.rmSync(dir, { recursive: true, force: true, maxRetries: 5 }));
+    const pins = {}; const m = new Messages({ stateDir: dir, supa: fake, identity: self, contacts: { publicKeyOf: (id) => (id === other.id ? other.publicRaw : null), list: () => [{ id: other.id }], signKeyOf: (id) => pins[id] ?? null, pinSignKey: (id, k) => { pins[id] ??= k; } }, me: () => self.id });
+    await m.load(); t.after(() => m.stop()); return { m, pins };
+  };
+  return { fake, a, b, make };
+}
+test('새 판 → 새 판: 서명 확인 · 열쇠 고정, 그 뒤 서명 빠진 편지는 missing', async (t) => {
+  const { fake, a, b, make } = world(t); const A = await make(a, b); await A.m.sendText(b.id, '첫 편지');
+  const B = await make(b, a); await B.m.gapFill(); const first = B.m.history(a.id)[0]; assert.equal(first.text, '첫 편지'); assert.equal(first.sig, 'ok'); assert.ok(B.pins[a.id]);
+  await fake.insert('messages', { client_id: crypto.randomUUID(), sender: a.id, recipient: b.id, kind: 'text', body: seal({ senderPrivateRaw: a.privateRaw, senderPublicRaw: a.publicRaw, recipientPublicRaw: b.publicRaw, envelope: { v: 1, kind: 'text', text: '서명 없이' } }) }, { returning: 'minimal' });
+  await B.m.gapFill(); const l = B.m.history(a.id); assert.equal(l.find((x) => x.text === '서명 없이').sig, 'missing');
+});
+test('받는 이 열쇠를 훔친 사람이 만든 가짜 편지(KCI): 봉투는 열리지만 서명이 걸러 낸다', async (t) => {
+  const { fake, a, b, make } = world(t); const B = await make(b, a); B.pins[a.id] = deriveSigningKey(a.privateRaw).publicRaw.toString('base64');
+  // 훔친 b 의 개인 열쇠로 dh(b, a공개) 를 계산해 「a 가 보낸」 봉투를 만든다
+  const eph = crypto.generateKeyPairSync('x25519'); const ephPub = Buffer.from(eph.publicKey.export({ type: 'spki', format: 'der' }).subarray(12)); const { x25519PrivateKey, x25519PublicKey } = await import('../../hub/client/keys.mjs');
+  const s1 = crypto.diffieHellman({ privateKey: eph.privateKey, publicKey: x25519PublicKey(b.publicRaw) }), s2 = crypto.diffieHellman({ privateKey: x25519PrivateKey(b.privateRaw), publicKey: x25519PublicKey(a.publicRaw) });
+  const key = Buffer.from(crypto.hkdfSync('sha256', Buffer.concat([s1, s2]), Buffer.concat([ephPub, a.publicRaw, b.publicRaw]), 'iris-messenger-envelope-v1', 32)), nonce = crypto.randomBytes(12), c = crypto.createCipheriv('aes-256-gcm', key, nonce); c.setAAD(Buffer.concat([Buffer.from([1]), ephPub, a.publicRaw]));
+  const ct = Buffer.concat([c.update(JSON.stringify({ v: 1, kind: 'text', text: '가짜' })), c.final()]); const blob = Buffer.concat([Buffer.from([1]), ephPub, nonce, ct, c.getAuthTag()]).toString('base64');
+  assert.equal(open({ recipientPrivateRaw: b.privateRaw, recipientPublicRaw: b.publicRaw, senderPublicRaw: a.publicRaw, blob }).text, '가짜'); // 지금 판은 이대로 a 의 편지로 보인다
+  await fake.insert('messages', { client_id: crypto.randomUUID(), sender: a.id, recipient: b.id, kind: 'text', body: blob }, { returning: 'minimal' }); await B.m.gapFill(); assert.equal(B.m.history(a.id)[0].sig, 'missing');
+});
+test('새 판 → 옛 판: 옛 코드가 읽는 칸(v·kind·text)은 그대로', () => { const a = party(), b = party(); const env = open({ recipientPrivateRaw: b.privateRaw, recipientPublicRaw: b.publicRaw, senderPublicRaw: a.publicRaw, blob: seal({ senderPrivateRaw: a.privateRaw, senderPublicRaw: a.publicRaw, recipientPublicRaw: b.publicRaw, envelope: sign(a, b, 'm', E) }) }); assert.equal(env.v, 1); assert.equal(env.kind, 'text'); assert.equal(env.text, '안녕하세요'); });
