+// IRIS Messenger · © 2026 Sejun Ham (함세준) · MIT · https://feynman520.github.io/card/#home
+// 편지 서명(제안): 12단어에서 나온 개인 열쇠로 Ed25519 서명 열쇠를 하나 더 유도한다 — 새로 보관할 비밀은 없다.
+// 서명은 봉투 「안」에 넣어 서버가 볼 수 없고, 옛 판은 모르는 칸(sig)이라 그냥 지나친다(봉투 v 는 1 그대로).
+// 서명하는 것 = 보낸 이 열쇠 + 받는 이 열쇠 + 편지 번호 + 내용(차례를 고정한 JSON) → 다른 사람·다른 편지로 옮겨 붙일 수 없다.
+import crypto from 'node:crypto';
+import { b64 } from './keys.mjs';
+
+const PKCS8_ED25519_PREFIX = Buffer.from('302e020100300506032b657004220420', 'hex');
+const SPKI_ED25519_PREFIX = Buffer.from('302a300506032b6570032100', 'hex');
+const LABEL = Buffer.from('iris-messenger-sig-v1\0', 'utf8');
+const priv = (seed) => crypto.createPrivateKey({ key: Buffer.concat([PKCS8_ED25519_PREFIX, seed]), format: 'der', type: 'pkcs8' });
+const pub = (raw) => crypto.createPublicKey({ key: Buffer.concat([SPKI_ED25519_PREFIX, raw]), format: 'der', type: 'spki' });
+
+export function deriveSigningKey(x25519PrivateRaw) {
+  const seed = Buffer.from(crypto.hkdfSync('sha256', x25519PrivateRaw, 'iris-messenger', 'ed25519-v1', 32));
+  return { seed, publicRaw: Buffer.from(crypto.createPublicKey(priv(seed)).export({ type: 'spki', format: 'der' }).subarray(12)) };
+}
+/** 칸 차례와 상관없는 같은 글(배열은 쓰지 않는다 — 봉투에 없다) */
+const canonical = (o) => JSON.stringify(Object.keys(o).filter((k) => k !== 'sig').sort().map((k) => [k, o[k]]));
+function digest({ senderPublicRaw, recipientPublicRaw, messageId, envelope }) {
+  const body = crypto.createHash('sha256').update(canonical(envelope), 'utf8').digest();
+  const id = crypto.createHash('sha256').update(String(messageId), 'utf8').digest();
+  return Buffer.concat([LABEL, senderPublicRaw, recipientPublicRaw, id, body]);
+}
+export function signEnvelope({ senderPrivateRaw, senderPublicRaw, recipientPublicRaw, messageId, envelope }) {
+  const k = deriveSigningKey(senderPrivateRaw);
+  const s = crypto.sign(null, digest({ senderPublicRaw, recipientPublicRaw, messageId, envelope }), priv(k.seed));
+  return { ...envelope, sig: { k: b64.enc(k.publicRaw), s: b64.enc(s) } };
+}
+/** → { state:'ok'|'none'|'bad', key } */
+export function checkEnvelope({ senderPublicRaw, recipientPublicRaw, messageId, envelope }) {
+  const sig = envelope?.sig; if (sig === undefined) return { state: 'none', key: null };
+  try {
+    const k = b64.dec(sig.k), s = b64.dec(sig.s); if (k.length !== 32 || s.length !== 64) return { state: 'bad', key: null };
+    return crypto.verify(null, digest({ senderPublicRaw, recipientPublicRaw, messageId, envelope }), pub(k), s) ? { state: 'ok', key: sig.k } : { state: 'bad', key: null };
+  } catch { return { state: 'bad', key: null }; }
+}
+/** 이 연락처에 고정해 둔 서명 열쇠와 견준다: ok(첫 서명이면 고정) · none(옛 판) · missing(전에는 서명했는데 빠짐) · changed · bad */
+export function judge(check, pinned) {
+  if (check.state === 'bad') return 'bad';
+  if (check.state === 'none') return pinned ? 'missing' : 'none';
+  return !pinned || pinned === check.key ? 'ok' : 'changed';
+}
